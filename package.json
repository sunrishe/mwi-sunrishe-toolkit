{
  "name": "mwi-sunrishe-toolkit",
  "version": "2.11.0",
  "packageManager": "yarn@1.22.22",
  "description": "MWI Sunrishe Toolkit 油猴脚本",
  "scripts": {
    "build": "yarn build:prepare && yarn build:prod",
    "build:dev": "cross-env MST_BUILD_ENV=development rollup -c rollup.config.mjs",
    "build:prepare": "yarn lint:fix && yarn format",
    "build:prod": "cross-env MST_BUILD_ENV=production rollup -c rollup.config.mjs",
    "watch": "cross-env MST_BUILD_ENV=development rollup -c rollup.config.mjs -w",
    "watch:server": "node scripts/watch-server.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests scripts rollup.config.mjs eslint.config.mjs",
    "lint:fix": "eslint src tests scripts rollup.config.mjs eslint.config.mjs --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "yarn build:prepare && yarn test && yarn build:dev && yarn build:prod",
    "prepare": "husky"
  },
  "keywords": [
    "userscript",
    "tampermonkey",
    "milkywayidle"
  ],
  "author": "sunrishe",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.6.2",
    "prettier-plugin-multiline-arrays-2": "^6.0.0",
    "rollup": "^4.46.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
